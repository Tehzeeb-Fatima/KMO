{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "destination": "/admin/login", "permanent": false }],
  "rewrites": [
    { "source": "/admin/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/admin/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" }
  ]
}
